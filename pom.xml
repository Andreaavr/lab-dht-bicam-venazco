<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>es.lab.dht</groupId>
    <artifactId>biciam</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>BiCIAM</name>
    <description>Biblioteca de metaheurísticas BiCIAM (algoritmos de búsqueda local, evolutivos y multiobjetivo).</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Versiones de dependencias -->
        <junit.version>5.12.2</junit.version>

        <!-- Versiones de plugins -->
        <compiler.plugin.version>3.14.0</compiler.plugin.version>
        <surefire.plugin.version>3.5.3</surefire.plugin.version>
        <jar.plugin.version>3.4.2</jar.plugin.version>
        <jacoco.plugin.version>0.8.13</jacoco.plugin.version>
        <pmd.plugin.version>3.26.0</pmd.plugin.version>
        <checkstyle.plugin.version>3.6.0</checkstyle.plugin.version>
        <spotbugs.plugin.version>4.9.3.0</spotbugs.plugin.version>
        <findsecbugs.version>1.14.0</findsecbugs.version>
        <dependency-check.plugin.version>12.1.9</dependency-check.plugin.version>
        <sonar.plugin.version>5.1.0.4751</sonar.plugin.version>

        <!-- ============ SonarCloud ============ -->
        <!-- Sustituya los valores por los de su organización/proyecto en sonarcloud.io -->
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.organization>andreaavr</sonar.organization>
        <sonar.projectKey>Andreaavr_lab-dht-bicam-venazco</sonar.projectKey>
        <sonar.projectName>lab-dht-bicam-venazco</sonar.projectName>
        <sonar.sourceEncoding>UTF-8</sonar.sourceEncoding>
        <!-- Cobertura generada por JaCoCo -->
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <!-- Informes externos de los plugins de la Fase 1 -->
        <sonar.java.pmd.reportPaths>${project.build.directory}/pmd.xml</sonar.java.pmd.reportPaths>
        <sonar.java.checkstyle.reportPaths>${project.build.directory}/checkstyle-result.xml</sonar.java.checkstyle.reportPaths>
        <sonar.java.spotbugs.reportPaths>${project.build.directory}/spotbugsXml.xml</sonar.java.spotbugs.reportPaths>
        <!--
          Mismas exclusiones que la regla de JaCoCo: generadores que en el código original
          no pueden ejecutarse de forma aislada (portafolio, PSO, EDA y sus hilos) y el main de la demo.
        -->
        <sonar.coverage.exclusions>**/metaheuristics/generators/MultiGenerator.java,**/metaheuristics/generators/ParticleSwarmOptimization.java,**/metaheuristics/generators/Particle.java,**/metaheuristics/generators/DistributionEstimationAlgorithm.java,**/metaheuristics/generators/Instance*.java,**/demo/BiciamDemo.java</sonar.coverage.exclusions>
        <!--
          Por si la versión de Checkstyle no aplica el fichero de supresiones, SonarCloud
          ignora igualmente las reglas de formato importadas (las mismas que en ese fichero).
        -->
        <sonar.issue.ignore.multicriteria>f1,f2,f3,f4,f5,f6,f7,f8,f9,f10,f11,f12,f13,f14,f15,f16</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.f1.ruleKey>external_checkstyle:whitespace.FileTabCharacterCheck</sonar.issue.ignore.multicriteria.f1.ruleKey>
        <sonar.issue.ignore.multicriteria.f1.resourceKey>**/*</sonar.issue.ignore.multicriteria.f1.resourceKey>
        <sonar.issue.ignore.multicriteria.f2.ruleKey>external_checkstyle:indentation.IndentationCheck</sonar.issue.ignore.multicriteria.f2.ruleKey>
        <sonar.issue.ignore.multicriteria.f2.resourceKey>**/*</sonar.issue.ignore.multicriteria.f2.resourceKey>
        <sonar.issue.ignore.multicriteria.f3.ruleKey>external_checkstyle:indentation.CommentsIndentationCheck</sonar.issue.ignore.multicriteria.f3.ruleKey>
        <sonar.issue.ignore.multicriteria.f3.resourceKey>**/*</sonar.issue.ignore.multicriteria.f3.resourceKey>
        <sonar.issue.ignore.multicriteria.f4.ruleKey>external_checkstyle:whitespace.WhitespaceAroundCheck</sonar.issue.ignore.multicriteria.f4.ruleKey>
        <sonar.issue.ignore.multicriteria.f4.resourceKey>**/*</sonar.issue.ignore.multicriteria.f4.resourceKey>
        <sonar.issue.ignore.multicriteria.f5.ruleKey>external_checkstyle:whitespace.WhitespaceAfterCheck</sonar.issue.ignore.multicriteria.f5.ruleKey>
        <sonar.issue.ignore.multicriteria.f5.resourceKey>**/*</sonar.issue.ignore.multicriteria.f5.resourceKey>
        <sonar.issue.ignore.multicriteria.f6.ruleKey>external_checkstyle:whitespace.NoWhitespaceBeforeCheck</sonar.issue.ignore.multicriteria.f6.ruleKey>
        <sonar.issue.ignore.multicriteria.f6.resourceKey>**/*</sonar.issue.ignore.multicriteria.f6.resourceKey>
        <sonar.issue.ignore.multicriteria.f7.ruleKey>external_checkstyle:whitespace.MethodParamPadCheck</sonar.issue.ignore.multicriteria.f7.ruleKey>
        <sonar.issue.ignore.multicriteria.f7.resourceKey>**/*</sonar.issue.ignore.multicriteria.f7.resourceKey>
        <sonar.issue.ignore.multicriteria.f8.ruleKey>external_checkstyle:whitespace.ParenPadCheck</sonar.issue.ignore.multicriteria.f8.ruleKey>
        <sonar.issue.ignore.multicriteria.f8.resourceKey>**/*</sonar.issue.ignore.multicriteria.f8.resourceKey>
        <sonar.issue.ignore.multicriteria.f9.ruleKey>external_checkstyle:whitespace.GenericWhitespaceCheck</sonar.issue.ignore.multicriteria.f9.ruleKey>
        <sonar.issue.ignore.multicriteria.f9.resourceKey>**/*</sonar.issue.ignore.multicriteria.f9.resourceKey>
        <sonar.issue.ignore.multicriteria.f10.ruleKey>external_checkstyle:whitespace.OperatorWrapCheck</sonar.issue.ignore.multicriteria.f10.ruleKey>
        <sonar.issue.ignore.multicriteria.f10.resourceKey>**/*</sonar.issue.ignore.multicriteria.f10.resourceKey>
        <sonar.issue.ignore.multicriteria.f11.ruleKey>external_checkstyle:sizes.LineLengthCheck</sonar.issue.ignore.multicriteria.f11.ruleKey>
        <sonar.issue.ignore.multicriteria.f11.resourceKey>**/*</sonar.issue.ignore.multicriteria.f11.resourceKey>
        <sonar.issue.ignore.multicriteria.f12.ruleKey>external_checkstyle:imports.CustomImportOrderCheck</sonar.issue.ignore.multicriteria.f12.ruleKey>
        <sonar.issue.ignore.multicriteria.f12.resourceKey>**/*</sonar.issue.ignore.multicriteria.f12.resourceKey>
        <sonar.issue.ignore.multicriteria.f13.ruleKey>external_checkstyle:whitespace.EmptyLineSeparatorCheck</sonar.issue.ignore.multicriteria.f13.ruleKey>
        <sonar.issue.ignore.multicriteria.f13.resourceKey>**/*</sonar.issue.ignore.multicriteria.f13.resourceKey>
        <sonar.issue.ignore.multicriteria.f14.ruleKey>external_checkstyle:RightCurlySame</sonar.issue.ignore.multicriteria.f14.ruleKey>
        <sonar.issue.ignore.multicriteria.f14.resourceKey>**/*</sonar.issue.ignore.multicriteria.f14.resourceKey>
        <sonar.issue.ignore.multicriteria.f15.ruleKey>external_checkstyle:RightCurlyAlone</sonar.issue.ignore.multicriteria.f15.ruleKey>
        <sonar.issue.ignore.multicriteria.f15.resourceKey>**/*</sonar.issue.ignore.multicriteria.f15.resourceKey>
        <sonar.issue.ignore.multicriteria.f16.ruleKey>external_checkstyle:blocks.LeftCurlyCheck</sonar.issue.ignore.multicriteria.f16.ruleKey>
        <sonar.issue.ignore.multicriteria.f16.resourceKey>**/*</sonar.issue.ignore.multicriteria.f16.resourceKey>

        <!-- Umbral de cobertura de línea exigido por JaCoCo en las clases probadas -->
        <jacoco.line.coverage.minimum>0.80</jacoco.line.coverage.minimum>
        <!-- OWASP: falla la build con vulnerabilidades de CVSS >= 7 (altas y críticas) -->
        <dependency-check.failBuildOnCVSS>7</dependency-check.failBuildOnCVSS>
        <!-- Filtro de SpotBugs: solo hallazgos de seguridad (ver config/spotbugs) -->
        <spotbugs.filter>config/spotbugs/spotbugs-security-include.xml</spotbugs.filter>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>biciam</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.plugin.version}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.plugin.version}</version>
            </plugin>

            <!-- Jar ejecutable: java -jar target/biciam.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${jar.plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>demo.BiciamDemo</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- ============================================================ -->
            <!-- JaCoCo: cobertura de las pruebas unitarias                     -->
            <!-- ============================================================ -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.plugin.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!--
                              La regla se aplica a las clases probadas. Se excluyen los
                              generadores que en el código original no pueden ejecutarse de
                              forma aislada (portafolio MultiGenerator, PSO, EDA y sus hilos
                              auxiliares) y el punto de entrada de la demo.
                            -->
                            <excludes>
                                <exclude>metaheuristics/generators/MultiGenerator.class</exclude>
                                <exclude>metaheuristics/generators/ParticleSwarmOptimization.class</exclude>
                                <exclude>metaheuristics/generators/Particle.class</exclude>
                                <exclude>metaheuristics/generators/DistributionEstimationAlgorithm.class</exclude>
                                <exclude>metaheuristics/generators/Instance*.class</exclude>
                                <exclude>demo/BiciamDemo*.class</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.coverage.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ============================================================ -->
            <!-- PMD: análisis estático (code smells y problemas de diseño)     -->
            <!-- ============================================================ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${pmd.plugin.version}</version>
                <configuration>
                    <targetJdk>17</targetJdk>
                    <rulesets>
                        <ruleset>/rulesets/java/quickstart.xml</ruleset>
                    </rulesets>
                    <format>xml</format>
                    <linkXRef>false</linkXRef>
                    <printFailingErrors>true</printFailingErrors>
                    <failOnViolation>false</failOnViolation>
                    <includeTests>false</includeTests>
                </configuration>
                <executions>
                    <execution>
                        <id>pmd-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                            <goal>cpd-check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- ============================================================ -->
            <!-- Checkstyle: estilo de código estándar                          -->
            <!-- ============================================================ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle.plugin.version}</version>
                <configuration>
                    <configLocation>google_checks.xml</configLocation>
                    <!-- Reglas solo de formato desactivadas: ver config/checkstyle/checkstyle-suppressions.xml -->
                    <suppressionsLocation>config/checkstyle/checkstyle-suppressions.xml</suppressionsLocation>
                    <suppressionsFileExpression>org.checkstyle.google.suppressionfilter.config</suppressionsFileExpression>
                    <inputEncoding>UTF-8</inputEncoding>
                    <consoleOutput>false</consoleOutput>
                    <violationSeverity>error</violationSeverity>
                    <failOnViolation>false</failOnViolation>
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- ============================================================ -->
            <!-- SpotBugs + FindSecBugs: bugs y vulnerabilidades (SAST)         -->
            <!-- ============================================================ -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs.plugin.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Low</threshold>
                    <xmlOutput>true</xmlOutput>
                    <!--
                      Por defecto solo se analiza la categoría SECURITY (SpotBugs + FindSecBugs)
                      y la build falla si aparece algún hallazgo. Para el informe completo:
                        mvn compile spotbugs:spotbugs -Dspotbugs.filter=config/spotbugs/spotbugs-all-include.xml
                    -->
                    <includeFilterFile>${spotbugs.filter}</includeFilterFile>
                    <failOnError>true</failOnError>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>${findsecbugs.version}</version>
                        </plugin>
                    </plugins>
                </configuration>
                <executions>
                    <!-- La build falla si aparece cualquier hallazgo de la categoría SECURITY -->
                    <execution>
                        <id>spotbugs-security-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- ============================================================ -->
            <!-- SonarCloud: mvn sonar:sonar -Dsonar.token=...                  -->
            <!-- ============================================================ -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar.plugin.version}</version>
            </plugin>

            <!-- ============================================================ -->
            <!-- OWASP Dependency-Check: CVEs conocidas en dependencias          -->
            <!-- ============================================================ -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${dependency-check.plugin.version}</version>
                <configuration>
                    <failBuildOnCVSS>${dependency-check.failBuildOnCVSS}</failBuildOnCVSS>
                    <!-- Clave de la API del NVD leída de la variable de entorno NVD_API_KEY -->
                    <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                    <suppressionFiles>
                        <suppressionFile>config/owasp/dependency-check-suppressions.xml</suppressionFile>
                    </suppressionFiles>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                        <format>XML</format>
                    </formats>
                    <!-- OSS Index exige credenciales desde 2025; se usa solo el NVD -->
                    <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                    <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                    <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
                    <nodeAuditAnalyzerEnabled>false</nodeAuditAnalyzerEnabled>
                    <retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>
                </configuration>
                <executions>
                    <execution>
                        <id>owasp-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${pmd.plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle.plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs.plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.plugin.version}</version>
                <reportSets>
                    <reportSet>
                        <reports>
                            <report>report</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>
        </plugins>
    </reporting>
</project>
