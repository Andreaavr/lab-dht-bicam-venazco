# Doxyfile 1.9 - Configuración de Doxygen para BiCIAM
#
# Generado con "doxygen -g" y adaptado al proyecto Java. Solo se incluyen las
# opciones que difieren de los valores por defecto de Doxygen.
#
# Uso (desde la raíz del repositorio):
#     doxygen Doxyfile
# La documentación HTML se genera en docs/html/index.html.

#---------------------------------------------------------------------------
# Proyecto
#---------------------------------------------------------------------------
DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "BiCIAM"
PROJECT_NUMBER         = 1.0.0
PROJECT_BRIEF          = "Biblioteca de metaheurísticas: búsqueda local, algoritmos evolutivos y multiobjetivo"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = Spanish

#---------------------------------------------------------------------------
# Lenguaje y estilo de comentarios
#---------------------------------------------------------------------------
OPTIMIZE_OUTPUT_JAVA   = YES
JAVADOC_AUTOBRIEF      = YES
JAVADOC_BANNER         = NO
MARKDOWN_SUPPORT       = YES
TAB_SIZE               = 4
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
FULL_PATH_NAMES        = NO

#---------------------------------------------------------------------------
# Qué se extrae
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO
SHOW_NAMESPACES        = YES

#---------------------------------------------------------------------------
# Avisos
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = docs/doxygen-warnings.log

#---------------------------------------------------------------------------
# Entrada
#---------------------------------------------------------------------------
INPUT                  = README.md \
                         src/main/java
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.java
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */test/*
USE_MDFILE_AS_MAINPAGE = README.md

#---------------------------------------------------------------------------
# Navegación por el código fuente
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
VERBATIM_HEADERS       = NO

#---------------------------------------------------------------------------
# Salida HTML
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

#---------------------------------------------------------------------------
# Otras salidas (desactivadas)
#---------------------------------------------------------------------------
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

#---------------------------------------------------------------------------
# Diagramas: requieren Graphviz (apt install graphviz). Sin él, ponga HAVE_DOT = NO
#---------------------------------------------------------------------------
CLASS_GRAPH            = YES
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
UML_LOOK               = YES
COLLABORATION_GRAPH    = YES
DIRECTORY_GRAPH        = NO
